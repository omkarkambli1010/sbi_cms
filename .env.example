# Server-only. None of these use the NEXT_PUBLIC_ prefix, which would inline
# the value into client JavaScript and defeat the point of the server boundary.

# ---------------------------------------------------------------------------
# Content service
#
# Everything under /api is forwarded to cms-backend (Go + Gin), which owns
# authentication, validation, uploads and every database call. This app holds
# no database connection at runtime. Session, media and public-API settings
# live in cms-backend/.env, not here.
# ---------------------------------------------------------------------------
CMS_BACKEND_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# PostgreSQL — used ONLY by `npm run db:*` (migrations, seeds, create-admin),
# which connect as the schema owner. The running app and cms-backend never use
# this; cms-backend connects as the execute-only sbi_cms_api role.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://sbi_cms:CHANGE_ME@localhost:5432/sbi_cms

# Where root-relative media paths resolve when the dashboard previews them.
# The existing artwork lives in the marketing site's public folder, not this
# app's, so a preview of /figma/... has to be fetched from there. Public by
# design: it is an origin, not a secret, and the preview renders in the
# browser. Uploads made through the dashboard ignore this.
NEXT_PUBLIC_MEDIA_ORIGIN=
