# Server-only. None of these use the NEXT_PUBLIC_ prefix, which would inline
# the value into client JavaScript and defeat the point of the server boundary.

# ---------------------------------------------------------------------------
# PostgreSQL — the CMS source of truth.
#
# Create the role and database once with db/setup.sql (run as a superuser),
# then put the matching URL here. The application role is not a superuser.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://sbi_cms:CHANGE_ME@localhost:5432/sbi_cms

# Pool sizing. Defaults are fine for local work.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Admin dashboard session
#
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every administrator out, which is the intended behaviour
# after a suspected leak.
# ---------------------------------------------------------------------------
CMS_SESSION_SECRET=
CMS_SESSION_TTL_HOURS=12

# Where uploaded media is written. Relative paths resolve against the repo root.
# In production this should be a mounted volume or object storage, not the app
# directory, so a redeploy does not discard editor uploads.
CMS_MEDIA_DIR=./public/uploads
CMS_MEDIA_PUBLIC_PATH=/uploads
CMS_MEDIA_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Public content API
#
# The marketing site reads published content from this app. The token is a
# shared secret between the two servers; it is never sent to a browser.
# Generate the same way as CMS_SESSION_SECRET.
# ---------------------------------------------------------------------------
CMS_PUBLIC_API_TOKEN=

# ---------------------------------------------------------------------------
# Development sign-in bypass
#
# `true` lets anyone who can reach the dashboard in as an administrator, with
# no account and no database. It exists so the screens can be reviewed before
# PostgreSQL is set up. A production build ignores it whatever it is set to,
# and the dashboard shows a banner on every screen while it is on.
#
# Leave it unset anywhere that is not your own machine.
# ---------------------------------------------------------------------------
CMS_DEV_BYPASS_AUTH=

# Where root-relative media paths resolve when the dashboard previews them.
# The existing artwork lives in the marketing site's public folder, not this
# app's, so a preview of /figma/... has to be fetched from there. Public by
# design: it is an origin, not a secret, and the preview renders in the
# browser. Uploads made through the dashboard ignore this.
NEXT_PUBLIC_MEDIA_ORIGIN=
